# Copy to `.env` and adjust. Consumed by Gradle's envOrProperty() in
# data/build.gradle.kts. Gradle does NOT auto-load .env; export it first, e.g.:
#   set -a; source .env; set +a
# Or override per invocation without a file:
#   ./gradlew :app:assembleDevDebug -PANDROID_BASE_URL=https://example.test/
#
# Base API URL baked into BuildConfig.BASE_URL for the selected flavor.
ANDROID_BASE_URL=https://dev.example.invalid/
