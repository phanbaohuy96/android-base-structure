<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="database" path="android_base.db" />
        <exclude domain="database" path="android_base.db-shm" />
        <exclude domain="database" path="android_base.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="database" path="android_base.db" />
        <exclude domain="database" path="android_base.db-shm" />
        <exclude domain="database" path="android_base.db-wal" />
    </device-transfer>
</data-extraction-rules>
